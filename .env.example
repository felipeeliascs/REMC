# .env.example

# WordPress
WP_DB_NAME=remc_db
WP_DB_USER=remc_user
WP_DB_PASSWORD=remc_pass
WP_DB_HOST=remc-mariadb:3306
WP_TABLE_PREFIX=remc_

# Administrator credentials (override with real values)
WP_ADMIN_USER=admin_remc
WP_ADMIN_PASSWORD=change_me
WP_ADMIN_EMAIL=admin@remc.local

# Site URL (do not change after first install)
WP_SITEURL=http://127.0.0.1
WP_HOME=http://127.0.0.1

# Security keys (generate with https://api.wordpress.org/secret-key/1.1/salt/)
AUTH_KEY=your-salt-key-here
SECURE_AUTH_KEY=your-salt-key-here
LOGGED_IN_KEY=your-salt-key-here
NONCE_KEY=your-salt-key-here
AUTH_SALT=your-salt-key-here
SECURE_AUTH_SALT=your-salt-key-here
LOGGED_IN_SALT=your-salt-key-here
NONCE_SALT=your-salt-key-here

# WP_DEBUG
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false


